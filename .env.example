# Required. Use a PagerDuty REST API token, or a full Authorization value such as:
# PD_API_TOKEN=Token token=...
# PD_API_TOKEN=Bearer ...
PD_API_TOKEN=REPLACE_WITH_PAGERDUTY_TOKEN

# Recommended. If omitted, the script will try to infer these from /users/me.
PD_USER_ID=PAGERDUTY_USER_ID
PD_FROM_EMAIL=you@example.com

# Safe by default. Set true only when you are ready for real acknowledgements.
PD_APPLY=false
PD_POLL_SECONDS=30

# Optional comma-separated safety filters.
PD_SERVICE_IDS=
PD_TEAM_IDS=
PD_ESCALATION_POLICY_IDS=
PD_SCHEDULE_IDS=

# Optional tuning.
PD_REQUEST_TIMEOUT_SECONDS=20
PD_MAX_PAGES=10
